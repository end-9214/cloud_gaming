# Copy this file to config/local.env and fill it in on the machine that
# runs the stack. config/local.env is gitignored. Never commit addresses,
# tokens, or passwords.

# Address the web hub listens on. Leave empty to use the Tailscale IPv4
# address when Tailscale is running, otherwise 127.0.0.1.
# Never set this to 0.0.0.0 in a shared or public environment.
HUB_BIND_ADDRESS=

HUB_PORT=28990

# Required before any POST (start, stop, pair, uninstall) is accepted.
# Generate one with: openssl rand -hex 32
HUB_TOKEN=

# Optional address returned by /api/stats. Leave empty so the hub does not
# publish a public address.
PUBLIC_IP=

# Steam manifest directory. Leave empty for ~/.local/share/Steam/steamapps.
STEAM_APPS_DIR=

# Optional. Leave empty so Sunshine keeps localhost available for pairing.
# Set a bind address only when you have confirmed localhost:47990 still works.
SUNSHINE_BIND_ADDRESS=
